{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@mtgproxy/web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@mtgproxy/web",
        "dev",
        "--port",
        "5273",
        "--strictPort"
      ],
      "port": 5273
    },
    {
      "name": "web-static",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@mtgproxy/web",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
